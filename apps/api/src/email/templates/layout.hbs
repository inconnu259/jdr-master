<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body style="margin:0; padding:0; background:#f4f4f5; font-family:Arial, sans-serif; color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5; padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:8px; padding:32px;">
            <tr>
              <td style="font-size:14px; line-height:1.5;">
                {{{body}}}
              </td>
            </tr>
            {{#if link}}
            {{#if actionLabel}}
            <tr>
              <td style="padding-top:8px;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center" bgcolor="#2e7d5a" style="background:#2e7d5a; border-radius:999px;">
                      <a href="{{link}}" style="display:inline-block; padding:10px 22px; font-family:Arial, sans-serif; font-size:14px; font-weight:bold; line-height:1.2; color:#ffffff; text-decoration:none;">{{actionLabel}}</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            {{/if}}
            {{/if}}
            <tr>
              <td style="padding-top:24px; font-size:12px; color:#6b7280;">
                Dés Dispos
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
